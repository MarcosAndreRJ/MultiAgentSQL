# MultiAgent SQL - Environment Variables Example
# Copy this to .env and fill in your values

# ============================================================
# Ollama Configuration
# ============================================================
OLLAMA_BASE_URL=http://192.168.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3.1
OLLAMA_TIMEOUT=480

# ============================================================
# Application Settings  
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change-me-in-production

# ============================================================
# Agent Configuration
# ============================================================
AGENTS_CONFIG_DIR=config/agents
SKILLS_DIR=config/skills
PROMPTS_DIR=config/prompts

GEMINI_API_KEY=AIzaSyDFkL-YUneNi_zd_ZR-53-hbX_MRI1ryP4
OLLAMA_CLOUD_API_KEY=fba5d158eab14241863d1d24a171b5f9.78JpEcEteKCsXSCwU_CAo--M

# ============================================================
# Guard & Pending Actions
# ============================================================
# TTL for pending actions in seconds (default: 5 minutes)
PENDING_ACTION_TTL=300

# ============================================================
# Session & Memory
# ============================================================
# Max messages to keep in session history
SESSION_MAX_MESSAGES=20
# Max SQL entries to keep in session
SESSION_MAX_SQL_HISTORY=5

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================================
# Database Defaults (can be overridden per agent)
# ============================================================
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=

# Maximum rows to return in a SELECT result
DB_MAX_RESULT_ROWS=500
